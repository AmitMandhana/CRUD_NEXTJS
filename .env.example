# MongoDB Configuration
# Replace with your actual MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/crud-nextjs

# For MongoDB Atlas (cloud), use this format instead:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database-name?retryWrites=true&w=majority

# Example local MongoDB URI
# MONGODB_URI=mongodb://127.0.0.1:27017/topics-app

# Note: Create a .env.local file with your actual values
# Do not commit sensitive information to version control