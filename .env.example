# MongoDB Connection String
# For local MongoDB installation:
MONGODB_URI=mongodb://localhost:27017/crud-nextjs

# For MongoDB Atlas (cloud):
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database-name

# Example with actual MongoDB Atlas connection:
# MONGODB_URI=mongodb+srv://myuser:mypassword@cluster0.example.mongodb.net/crud-nextjs-db?retryWrites=true&w=majority